;; Base layer: layer-taps under the thumbs + home-row mods in GASC order
;; Left  hand: A=Gui  S=Alt  D=Shift  F=Ctrl
;; Right hand: J=Ctrl  K=Shift  L=Alt  ;=Gui

(deflayer base
  _    _    _    _    _    _    _    _    _    _    _
  q    w    e    r    t         y    u    i    o    p
  @aa  @ss  @dd  @ff  g         h    @jj  @kk  @ll  @scln
  z    x    c    v    b    <    n    m    ,    .    /
            @sft          @nav            @sym
  @sym         @sym         bspc    lsft
)

;; Timing variables are defined in `kanata.kbd` file.

(defalias
  ;; Main mod-tap: Nav layer when held, Space when tapped.
  ;; A tap while Shift is held gives Delete instead of Space. `unmod` drops the
  ;; held Shift so applications receive a bare Del, not Shift+Del.
  spcdel (fork spc (unmod del) (lsft rsft))
  nav (tap-hold $tap_timeout $long_hold_timeout @spcdel (layer-while-held navigation))

  ;; Space-cadet left thumb: Shift when held, BackSpace when tapped.
  sft (tap-hold-press $tap_timeout $hold_timeout bspc lsft)

  ;; AltGr thumb key: Symbols layer while held, nothing when tapped.
  ;; Enter is the [,]+[.] chord, see `kanata.kbd`.
  sym (layer-while-held symbols)

  ;; Home-row mods, GASC order (Gui / Alt / Shift / Ctrl, outer to inner).
  ;; `lalt` is used on both hands: `ralt` is AltGr on Windows and would fire
  ;; the layout's symbol layer instead of acting as a plain Alt.
  aa (tap-hold $tap_timeout $long_hold_timeout a lmet)
  ss (tap-hold $tap_timeout $long_hold_timeout s lalt)
  dd (tap-hold $tap_timeout $long_hold_timeout d lsft)
  ff (tap-hold $tap_timeout $long_hold_timeout f lctl)
  jj (tap-hold $tap_timeout $long_hold_timeout j rctl)
  kk (tap-hold $tap_timeout $long_hold_timeout k rsft)
  ll (tap-hold $tap_timeout $long_hold_timeout l lalt)
  scln (tap-hold $tap_timeout $long_hold_timeout ; rmet)
)

;; vim: set ft=lisp
